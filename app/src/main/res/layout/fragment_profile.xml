<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ProfileFragment">

    <!-- Wrapped in ScrollView to prevent fields from clipping on smaller screens -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="20dp">

            <ImageView
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:background="@drawable/circular_bg"
                android:backgroundTint="@color/my_primary"
                android:src="@drawable/person_icon"
                android:scaleType="centerCrop"
                android:layout_marginBottom="30dp"
                android:id="@+id/profile_image_view"/>

            <EditText
                android:id="@+id/profile_username"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="5dp"
                android:background="@drawable/edit_text_rounded_corner"
                android:elevation="5dp"
                android:hint="Username"
                android:inputType="textPersonName"
                android:padding="10dp" />

            <EditText
                android:id="@+id/profile_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/edit_text_rounded_corner"
                android:elevation="5dp"
                android:enabled="false"
                android:hint="Email"
                android:inputType="textEmailAddress"
                android:padding="10dp" />

            <!-- Dropdown Menu for Occupation -->
            <!-- Dropdown Menu for Occupation -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/profile_occupation_layout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_marginBottom="10dp"
                android:elevation="5dp"
                android:hint="Occupation">

                <AutoCompleteTextView
                    android:id="@+id/profile_occupation_spinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:saveEnabled="false"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Dropdown Menu for Mechina -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/profile_mechina_layout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_marginBottom="10dp"
                android:elevation="5dp"
                android:hint="Select Mechina"
                android:visibility="gone">

                <AutoCompleteTextView
                    android:id="@+id/profile_mechina_spinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:saveEnabled="false"
                    android:inputType="text"/>

            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="15dp">

                <Button
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/my_primary"
                    android:text="Update profile"
                    android:id="@+id/profile_update_btn"/>

                <ProgressBar
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:indeterminateTint="@color/my_secondary"
                    android:layout_gravity="center"
                    android:id="@+id/profile_progress_bar"
                    android:visibility="gone"/>

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Logout"
                android:layout_marginBottom="20dp"
                android:id="@+id/logout_btn"/>

        </LinearLayout>
    </ScrollView>

    <!-- Crop Container remains the same -->
    <LinearLayout
        android:id="@+id/crop_container_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#E6000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <com.canhub.cropper.CropImageView
            android:id="@+id/crop_image_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:cropShape="oval"
            app:cropFixAspectRatio="true"
            app:cropAspectRatioX="1"
            app:cropAspectRatioY="1"
            app:cropGuidelines="on"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="16dp"
            android:background="#222222">

            <Button
                android:id="@+id/btn_cancel_crop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#444444"
                android:text="Cancel"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btn_confirm_crop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/my_secondary"
                android:text="Crop Picture"
                android:textColor="#FFFFFF" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>